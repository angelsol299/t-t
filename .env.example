# Where the app reaches the server. Point it at Toxiproxy (port 4000) so the
# simulator can degrade the network; point it at :3000 to bypass Toxiproxy.
#   iOS simulator:     http://localhost:4000
#   Android emulator:  http://10.0.2.2:4000
#   Physical phone:    http://<your Mac's LAN IP>:4000
EXPO_PUBLIC_SERVER_URL=
# Phone number for the "Urgent? Call reception" button
EXPO_PUBLIC_RECEPTION_PHONE=+4512345678
